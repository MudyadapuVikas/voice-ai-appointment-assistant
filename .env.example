# Copy to .env (in this folder or in backend/) and fill in. Never commit .env.

# ElevenLabs: speech-to-text (Scribe Realtime) and text-to-speech
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: any voice from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Google Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Optional
CLINIC_NAME=Halcyon Clinic
CLINIC_TZ=Asia/Kolkata
# DB_PATH=backend/data/clinic.db

# Advanced: endpoint overrides (regional endpoints; the e2e test points these at its emulator)
# ELEVENLABS_TTS_URL=wss://api.elevenlabs.io
# ELEVENLABS_STT_HOST=api.elevenlabs.io
# GEMINI_BASE_URL=
